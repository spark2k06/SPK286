# SPDX-License-Identifier: MIT
microcode_format 13

instruction PUSH_ALL:
    CHECK_PUSH8
    READ_SP -> TMP0
    SAVE_AUX TMP0
    READ_AX -> TMP0
    PUSH16 DECODED TMP0
    READ_CX -> TMP0
    PUSH16 DECODED TMP0
    READ_DX -> TMP0
    PUSH16 DECODED TMP0
    READ_BX -> TMP0
    PUSH16 DECODED TMP0
    RESTORE_AUX -> TMP0
    PUSH16 DECODED TMP0
    READ_BP -> TMP0
    PUSH16 DECODED TMP0
    READ_SI -> TMP0
    PUSH16 DECODED TMP0
    READ_DI -> TMP0
    PUSH16 DECODED TMP0
    END

instruction POP_ALL:
    CHECK_POP8
    POP16 -> TMP0
    TMP0 -> DI
    POP16 -> TMP0
    TMP0 -> SI
    POP16 -> TMP0
    TMP0 -> BP
    POP16 -> TMP0
    POP16 -> TMP0
    TMP0 -> BX
    POP16 -> TMP0
    TMP0 -> DX
    POP16 -> TMP0
    TMP0 -> CX
    POP16 -> TMP0
    TMP0 -> AX
    END

instruction ENTER_FRAME:
    FETCH_IMM16 -> TMP0
    SAVE_ALLOCATION TMP0
    FETCH_IMM8 -> TMP1
    LOAD_COUNTER TMP1
    BEGIN_STACK_CURSOR
    READ_BP -> TMP0
    PUSH16 DECODED TMP0
    READ_STACK_CURSOR -> TMP0
    SAVE_AUX TMP0
    READ_BP -> TMP0
    SET_STACK_ADDRESS TMP0
    BRANCH_ZERO finish
    DECREMENT_COUNTER
    BRANCH_ZERO push_frame
copy_parent:
    DECREMENT_STACK_ADDRESS
    READ_STACK_ADDRESS -> TMP0
    PUSH16 DECODED TMP0
    DECREMENT_COUNTER
    BRANCH_NONZERO copy_parent
push_frame:
    RESTORE_AUX -> TMP0
    PUSH16 DECODED TMP0
finish:
    RESTORE_AUX -> TMP0
    TMP0 -> BP
    ALLOCATE_STACK
    END

instruction LEAVE_FRAME:
    READ_BP -> TMP0
    CHECK_STACK TMP0
    TMP0 -> SP
    POP16 -> TMP0
    TMP0 -> BP
    END

instruction CHECK_BOUNDS:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SAVE_AUX TMP0
    READ_REG16 -> TMP1
    SET_EA_PLUS2
    READ_RM16 -> TMP0
    CHECK_BOUNDS
    END
