microcode_format 24

# PM1 system instructions remain ordinary project-owned microcode entries.
instruction SYSTEM_GROUP_0F01:
    DECODE_MODRM
    DISPATCH DECODED

instruction SYSTEM_STORE_GDTR:
    SYSTEM_STORE_GDTR
    END

instruction SYSTEM_STORE_IDTR:
    SYSTEM_STORE_IDTR
    END

instruction SYSTEM_LOAD_GDTR:
    SYSTEM_LOAD_GDTR
    END

instruction SYSTEM_LOAD_IDTR:
    SYSTEM_LOAD_IDTR
    END

instruction SYSTEM_STORE_MSW:
    SYSTEM_STORE_MSW
    END

instruction SYSTEM_LOAD_MSW:
    SYSTEM_LOAD_MSW
    END

instruction SYSTEM_GROUP_0F00:
    DECODE_MODRM
    DISPATCH DECODED

instruction SYSTEM_STORE_LDTR:
    CHECK_PROTECTED_MODE
    SYSTEM_STORE_LDTR
    END

instruction SYSTEM_STORE_TR:
    CHECK_PROTECTED_MODE
    SYSTEM_STORE_TR
    END

instruction SYSTEM_LOAD_LDTR:
    CHECK_SYSTEM_PRIVILEGE
    READ_RM16 -> TMP0
    SYSTEM_LOAD_LDTR
    END

instruction SYSTEM_LOAD_TR:
    CHECK_SYSTEM_PRIVILEGE
    READ_RM16 -> TMP0
    SYSTEM_LOAD_TR
    END

instruction SYSTEM_VERIFY_READ:
    CHECK_PROTECTED_MODE
    READ_RM16 -> TMP0
    SYSTEM_VERIFY_READ
    END

instruction SYSTEM_VERIFY_WRITE:
    CHECK_PROTECTED_MODE
    READ_RM16 -> TMP0
    SYSTEM_VERIFY_WRITE
    END

instruction SYSTEM_LOAD_ACCESS:
    DECODE_MODRM
    CHECK_PROTECTED_MODE
    READ_RM16 -> TMP0
    SYSTEM_LOAD_ACCESS
    END

instruction SYSTEM_LOAD_LIMIT:
    DECODE_MODRM
    CHECK_PROTECTED_MODE
    READ_RM16 -> TMP0
    SYSTEM_LOAD_LIMIT
    END

instruction SYSTEM_ARPL:
    DECODE_MODRM
    SYSTEM_ARPL_CHECK
    READ_RM16 -> TMP0
    READ_REG16 -> TMP1
    SYSTEM_ARPL
    END

instruction SYSTEM_CLTS:
    SYSTEM_CLTS
    END
