# SPDX-License-Identifier: MIT
microcode_format 16

# Explicit functional iteration; opcode decoding and physical bus cycles stay outside.

instruction STRING_MOVE:
    BRANCH_REPEAT_EMPTY done
loop:
    STEP_STRING_SOURCE
    REPEAT_COUNT
    READ_STRING_TMP0
    STEP_STRING_DEST
    WRITE_STRING_TMP0
    BRANCH_REPEAT_CONTINUE loop
done:
    END

instruction STRING_COMPARE:
    BRANCH_REPEAT_EMPTY done
loop:
    STEP_STRING_DEST
    READ_STRING_TMP1
    REPEAT_COUNT
    STEP_STRING_SOURCE
    READ_STRING_TMP0
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> DST IF_WRITE
    COMMIT_FLAGS
    BRANCH_REPEAT_CONTINUE loop
done:
    END

instruction STRING_STORE:
    BRANCH_REPEAT_EMPTY done
    READ_STRING_ACCUMULATOR
loop:
    REPEAT_COUNT
    STEP_STRING_DEST
    WRITE_STRING_TMP0
    BRANCH_REPEAT_CONTINUE loop
done:
    END

instruction STRING_LOAD:
    BRANCH_REPEAT_EMPTY done
loop:
    REPEAT_COUNT
    STEP_STRING_SOURCE
    READ_STRING_TMP0
    WRITE_STRING_ACCUMULATOR
    BRANCH_REPEAT_CONTINUE loop
done:
    END

instruction STRING_SCAN:
    BRANCH_REPEAT_EMPTY done
loop:
    STEP_STRING_DEST
    REPEAT_COUNT
    READ_STRING_TMP1
    READ_STRING_ACCUMULATOR
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> DST IF_WRITE
    COMMIT_FLAGS
    BRANCH_REPEAT_CONTINUE loop
done:
    END
