# Shared real-mode event services; no instruction-level timing padding.
microcode_format 18

instruction PUSH_FLAGS:
    READ_FLAGS -> TMP0
    PUSH16 DECODED TMP0
    END

instruction POP_FLAGS:
    POP16 -> TMP0
    RESTORE_FLAGS TMP0
    END

instruction CONTROL_IF:
    SET_IF DECODED
    END

instruction HALT_CPU:
    HALT
    END

instruction SOFTWARE_EVENT:
    REQUEST_EVENT DECODED
    END

instruction SOFTWARE_EVENT_IMM8:
    FETCH_IMM8 -> TMP0
    REQUEST_EVENT DECODED
    END

instruction INTERRUPT_RETURN:
    POP16 -> TMP0
    POP16 -> TMP1
    POP16 -> TMP2
    VALIDATE_IRET_CS
    IRET_OUTER_FRAME
    VALIDATE_IRET_SS
    IRET_COMMIT TMP0 TMP1 TMP2
    END

instruction EVENT_ENTRY:
    EVENT_ACK
    VALIDATE_EVENT_GATE
    EVENT_FLAGS -> TMP0
    PUSH16 DECODED TMP0
    EVENT_CS -> TMP0
    PUSH16 DECODED TMP0
    EVENT_IP -> TMP0
    PUSH16 DECODED TMP0
    EVENT_GATE_IP -> TMP0
    EVENT_GATE_CS -> TMP1
    VALIDATE_CS
    EVENT_GATE_IP -> TMP0
    EVENT_GATE_CS -> TMP1
    CLEAR_EVENT_FLAGS
    PUSH_EVENT_ERROR
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction EVENT_ENTRY_PROTECTED:
    EVENT_ACK
    VALIDATE_EVENT_GATE
    EVENT_GATE_IP -> TMP0
    EVENT_GATE_CS -> TMP1
    VALIDATE_CS
    VALIDATE_CALL_STACK
    VALIDATE_CALL_SS
    CHECK_CALL_FRAME
    CALL_GATE_STACK_SWITCH
    EVENT_FLAGS -> TMP0
    PUSH16 DECODED TMP0
    EVENT_CS -> TMP0
    PUSH16 DECODED TMP0
    EVENT_IP -> TMP0
    PUSH16 DECODED TMP0
    EVENT_GATE_IP -> TMP0
    EVENT_GATE_CS -> TMP1
    CLEAR_EVENT_FLAGS
    PUSH_EVENT_ERROR
    CONTEXT_COMMIT TMP0 TMP1
    END
