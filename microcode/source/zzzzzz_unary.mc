# SPDX-License-Identifier: MIT
microcode_format 22
# Group dispatch is terminal; targets reuse the cached operand context.
instruction GROUP3_DISPATCH:
    DECODE_MODRM
    DISPATCH DECODED
instruction GROUP5_DISPATCH:
    DECODE_MODRM
    DISPATCH DECODED
instruction NOT_RM8:
    DECODE_UNARY_RM8
    READ_RM8 -> TMP0
    CONST_ONES -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction NOT_RM16:
    DECODE_UNARY_RM16
    READ_RM16 -> TMP0
    CONST_ONES -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM16 IF_WRITE
    COMMIT_FLAGS
    END
instruction NEG_RM8:
    DECODE_UNARY_RM8
    READ_RM8 -> TMP0
    CONST_ZERO -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction NEG_RM16:
    DECODE_UNARY_RM16
    READ_RM16 -> TMP0
    CONST_ZERO -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM16 IF_WRITE
    COMMIT_FLAGS
    END
instruction INC_DEC_RM8:
    DECODE_UNARY_RM8
    READ_RM8 -> TMP0
    CONST_ONE -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction INC_DEC_RM16:
    DECODE_UNARY_RM16
    READ_RM16 -> TMP0
    CONST_ONE -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM16 IF_WRITE
    COMMIT_FLAGS
    END
