# SPDX-License-Identifier: MIT
# Acquired far pointers precede stack/cache/register disposition.
microcode_format 20

instruction LOAD_POINTER:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SAVE_AUX TMP0
    SET_EA_PLUS2
    READ_RM16 -> TMP0
    TMP0 -> SEG16
    RESTORE_AUX -> TMP0
    TMP0 -> REG16
    END

instruction CALL_FAR_IMM:
    FETCH_IMM16 -> TMP0
    FETCH_IMM16 -> TMP1
    VALIDATE_CALL_GATE
    TASK_SWITCH
    VALIDATE_CALL_CS
    VALIDATE_CALL_STACK
    VALIDATE_CALL_SS
    CHECK_CALL_FRAME
    CALL_GATE_STACK_SWITCH
    COPY_CALL_PARAMETERS
    SAVE_AUX TMP0
    READ_SEG16 -> TMP0
    PUSH16 DECODED TMP0
    READ_IP16 -> TMP0
    PUSH16 DECODED TMP0
    RESTORE_AUX -> TMP0
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction JMP_FAR_IMM:
    FETCH_IMM16 -> TMP0
    FETCH_IMM16 -> TMP1
    VALIDATE_CS
    TASK_SWITCH
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction CALL_FAR_RM:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SET_EA_PLUS2
    READ_RM16 -> TMP1
    VALIDATE_CALL_GATE
    TASK_SWITCH
    VALIDATE_CALL_CS
    VALIDATE_CALL_STACK
    VALIDATE_CALL_SS
    CHECK_CALL_FRAME
    CALL_GATE_STACK_SWITCH
    COPY_CALL_PARAMETERS
    SAVE_AUX TMP0
    READ_SEG16 -> TMP0
    PUSH16 DECODED TMP0
    READ_IP16 -> TMP0
    PUSH16 DECODED TMP0
    RESTORE_AUX -> TMP0
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction JMP_FAR_RM:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SET_EA_PLUS2
    READ_RM16 -> TMP1
    VALIDATE_CS
    TASK_SWITCH
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction RET_FAR:
    CHECK_POP2
    POP16 -> TMP0
    POP16 -> TMP1
    VALIDATE_IRET_CS
    IRET_OUTER_FRAME
    VALIDATE_IRET_SS
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction RET_FAR_IMM:
    FETCH_IMM16 -> TMP0
    SAVE_ALLOCATION TMP0
    CHECK_POP2
    POP16 -> TMP0
    POP16 -> TMP1
    VALIDATE_IRET_CS
    IRET_OUTER_FRAME
    VALIDATE_IRET_SS
    ADD_ALLOCATION_SP
    CONTEXT_COMMIT TMP0 TMP1
    END
