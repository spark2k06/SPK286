microcode_format 23
# Explicit byte widths; original word and event programs retain their controls.
instruction MOV_R8_IMM8:
    FETCH_MOV_DST8_IMM8
    TMP0 -> DST8
    END
instruction MOV_RM8_R8:
    DECODE_MOV_RM8_REG8
    READ_REG8 -> TMP0
    TMP0 -> RM8
    END
instruction MOV_R8_RM8:
    DECODE_MOV_REG8_RM8
    READ_RM8 -> TMP0
    TMP0 -> REG8
    END
instruction MOV_RM8_IMM8:
    DECODE_MODRM
    FETCH_MOV_RM8_IMM8
    TMP0 -> RM8
    END
instruction MOV_RM16_IMM16:
    DECODE_MODRM
    FETCH_MOV_RM16_IMM16
    TMP0 -> RM16
    END
instruction ALU_RM8_R8:
    DECODE_ALU_RM8_REG8
    READ_RM8 -> TMP0
    READ_REG8 -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction ALU_R8_RM8:
    DECODE_ALU_REG8_RM8
    READ_REG8 -> TMP0
    READ_RM8 -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> REG8 IF_WRITE
    COMMIT_FLAGS
    END
instruction ALU_AL_IMM8:
    FETCH_ALU_DST8_IMM8
    FETCH_IMM8 -> TMP1
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> DST8 IF_WRITE
    COMMIT_FLAGS
    END
instruction ALU_RM8_IMM8:
    DECODE_MODRM
    FETCH_ALU_RM8_IMM8
    READ_RM8 -> TMP0
    ALU DECODED TMP0, TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
