# Acquired far pointers precede stack/cache/register disposition.
microcode_format 14

instruction LOAD_POINTER:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SAVE_AUX TMP0
    SET_EA_PLUS2
    READ_RM16 -> TMP0
    TMP0 -> SEG16
    RESTORE_AUX -> TMP0
    TMP0 -> REG16
    END

instruction CALL_FAR_IMM:
    FETCH_IMM16 -> TMP0
    FETCH_IMM16 -> TMP1
    CHECK_PUSH2
    SAVE_AUX TMP0
    READ_SEG16 -> TMP0
    PUSH16 DECODED TMP0
    READ_IP16 -> TMP0
    PUSH16 DECODED TMP0
    RESTORE_AUX -> TMP0
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction JMP_FAR_IMM:
    FETCH_IMM16 -> TMP0
    FETCH_IMM16 -> TMP1
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction CALL_FAR_RM:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SET_EA_PLUS2
    READ_RM16 -> TMP1
    CHECK_PUSH2
    SAVE_AUX TMP0
    READ_SEG16 -> TMP0
    PUSH16 DECODED TMP0
    READ_IP16 -> TMP0
    PUSH16 DECODED TMP0
    RESTORE_AUX -> TMP0
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction JMP_FAR_RM:
    DECODE_MODRM
    CHECK_RM32
    READ_RM16 -> TMP0
    SET_EA_PLUS2
    READ_RM16 -> TMP1
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction RET_FAR:
    CHECK_POP2
    POP16 -> TMP0
    POP16 -> TMP1
    CONTEXT_COMMIT TMP0 TMP1
    END

instruction RET_FAR_IMM:
    FETCH_IMM16 -> TMP0
    SAVE_ALLOCATION TMP0
    CHECK_POP2
    POP16 -> TMP0
    POP16 -> TMP1
    ADD_ALLOCATION_SP
    CONTEXT_COMMIT TMP0 TMP1
    END
