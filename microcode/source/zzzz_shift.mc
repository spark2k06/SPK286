# SPDX-License-Identifier: MIT
microcode_format 8
# Count acquisition precedes data access; count zero still performs the real operand read.
instruction SHIFT_RM8_ONE:
    DECODE_MODRM
    CONST_ONE -> TMP1
    READ_RM8 -> TMP0
    SHIFT DECODED TMP0 TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction SHIFT_RM8_CL:
    DECODE_MODRM
    COUNT_LOW -> TMP1
    READ_RM8 -> TMP0
    SHIFT DECODED TMP0 TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction SHIFT_RM8_IMM8:
    DECODE_MODRM
    FETCH_IMM8 -> TMP1
    READ_RM8 -> TMP0
    SHIFT DECODED TMP0 TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM8 IF_WRITE
    COMMIT_FLAGS
    END
instruction SHIFT_RM16_ONE:
    DECODE_MODRM
    CONST_ONE -> TMP1
    READ_RM16 -> TMP0
    SHIFT DECODED TMP0 TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM16 IF_WRITE
    COMMIT_FLAGS
    END
instruction SHIFT_RM16_CL:
    DECODE_MODRM
    COUNT_LOW -> TMP1
    READ_RM16 -> TMP0
    SHIFT DECODED TMP0 TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM16 IF_WRITE
    COMMIT_FLAGS
    END
instruction SHIFT_RM16_IMM8:
    DECODE_MODRM
    FETCH_IMM8 -> TMP1
    READ_RM16 -> TMP0
    SHIFT DECODED TMP0 TMP1 -> TMP2 FLAGS_DECODED
    TMP2 -> RM16 IF_WRITE
    COMMIT_FLAGS
    END
